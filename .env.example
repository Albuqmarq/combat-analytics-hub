# Copie para .env e defina valores fortes. O .env NAO e versionado (ver .gitignore).

# Chave de integracao interna entre gateway <-> inference <-> mlops.
INTERNAL_API_KEY=troque-por-uma-chave-forte

# Chave de administrador exigida para disparar o treino (/api/v1/admin/train).
ADMIN_API_KEY=troque-por-outra-chave-forte

# Origens permitidas no CORS do gateway (separadas por virgula).
ALLOWED_ORIGINS=http://localhost:3000

# (Opcional) Conector de dados Kaggle — ative para atualizar o master.csv automaticamente.
# Gere o token em kaggle.com -> Account -> Create New API Token (kaggle.json).
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_DATASET=mdabbert/ultimate-ufc-dataset
KAGGLE_CSV=
